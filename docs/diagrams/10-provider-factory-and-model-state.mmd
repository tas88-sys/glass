%% 10 - AI Provider Factory + Model State resolution
%% A single registry (factory.js PROVIDERS) drives the whole model layer and the
%% Settings UI. modelStateService resolves {provider, model, apiKey} at call time,
%% plus keys for an LLM list that names several providers (diagram 17).
flowchart TB
    subgraph registry["factory.js — PROVIDERS registry (single source of truth)"]
        direction LR
        r1["openai: LLM gpt-4.1 · STT gpt-4o-mini-transcribe"]
        r2["openai-glass: hosted via Portkey virtual key"]
        r3["gemini: LLM gemini-3-flash-preview (CSV failover) · STT gemini-3.8-live"]
        r4["anthropic: LLM claude-opus-5-5 · claude-sonnet-5-5 · claude-haiku-5-5 (CSV failover) · STT none"]
        r8["groq: LLM openai/gpt-oss-120b · openai/gpt-oss-20b · qwen/qwen3.8-27b (CSV failover) · STT none"]
        r5["deepgram: STT nova-3 · LLM none"]
        r6["ollama: LLM dynamic (local) · STT none"]
        r7["whisper: STT tiny/base/small/medium (local, main only)"]
    end

    subgraph state["modelStateService"]
        keys["provider_settings table<br/>api_key (encrypted at rest if Firebase)<br/>selected_llm_model / selected_stt_model<br/>is_active_llm / is_active_stt"]
        auto["_autoSelectAvailableModels()<br/>picks a valid model when key added/removed"]
        resolve["getCurrentModelInfo('llm' | 'stt')<br/>-> {provider, model, apiKey}<br/>llm also: keys of every provider the list names"]
        gate["areProvidersConfigured()<br/>requires BOTH an LLM key AND an STT key"]
        infer["getProviderForModel(id, field)<br/>presets, then Ollama installs, then typed IDs / CSV:<br/>inferProviderFromModelId — the provider whose models list has it<br/>(model catalog; several: the field); else the prefix:<br/>gemini- → gemini, claude- → anthropic, vendor/model → groq<br/>(Anthropic and Groq LLM only)"]
        catalog["model_catalog table + modelCatalog.js<br/>what each model can do, read from the models APIs;<br/>refreshed at startup, on a key or list saved;<br/>overrides from Settings"]
    end

    subgraph consumers["Consumers"]
        ask["askService -> createStreamingLLM"]
        summ["summaryService -> createLLM"]
        stt["sttService -> createSTT x2"]
    end

    registry --> state
    catalog --> infer
    keys --> resolve
    resolve --> consumers
    consumers --> dispatch["factory.createLLM / createStreamingLLM / createSTT<br/>removes keys; sanitizeModelId strips '-glass'"]
    dispatch --> split{"splitByProvider(model, provider):<br/>how many providers?"}
    split -->|"one"| registry
    split -->|"two or more"| chain["providerChain.js<br/>runs each provider's segment in turn,<br/>each with its own key (diagram 17)"]
    chain --> registry

    settingsui["SettingsView (data-driven)<br/>renders one API-key field per provider<br/>+ Gemini, Anthropic and Groq model-list inputs"] --> keys
    settingsui --> infer
    health["providers/modelHealth.js<br/>one in-memory cooldown registry,<br/>shared by the Gemini, Anthropic and Groq failover loops;<br/>isCoolingDown read by the chain"]
    registry -.-> health
    chain -.-> health
